        function setPromptLevel(p) {
            activePrompt = p;
            document.querySelectorAll('#tracker-prompt-buttons .p-btn').forEach(btn => {
                if (btn.dataset.p === p) {
                    btn.classList.add('bg-nasaq-petrol', 'text-white');
                    btn.classList.remove('bg-white', 'text-nasaq-navy');
                } else {
                    btn.classList.remove('bg-nasaq-petrol', 'text-white');
                    btn.classList.add('bg-white', 'text-nasaq-navy');
                }
            });
        }

        function logTrial(isCorrect) {
            const benId = document.getElementById('tracker-ben-select').value;
            const goalId = document.getElementById('tracker-goal-select').value;

            if (!benId || !goalId) {
                alert('يرجى التأكد من اختيار المستفيد والهدف المسجل.');
                return;
            }

            appDB.trials.push({
                id: 'tr-' + Date.now(),
                benId, goalId, isCorrect,
                prompt: activePrompt,
                time: new Date().toLocaleTimeString('ar-EG')
            });

            saveDB();
            updateTrackerMetrics();
        }

        function updateTrackerMetrics() {
            const benId = document.getElementById('tracker-ben-select').value;
            const goalId = document.getElementById('tracker-goal-select').value;

            const trials = appDB.trials.filter(t => t.benId === benId && t.goalId === goalId);
            const total = trials.length;
            const correct = trials.filter(t => t.isCorrect).length;

            document.getElementById('tracker-count-total').textContent = total;
            document.getElementById('tracker-count-correct').textContent = correct;

            const rateEl = document.getElementById('tracker-rate-pct');
            if (total === 0) {
                rateEl.textContent = 'بيانات غير كافية';
            } else {
                const pct = Math.round((correct / total) * 100);
                rateEl.textContent = `${pct}% (${correct}/${total})`;
            }

            const tape = document.getElementById('tracker-tape');
            if (total === 0) {
                tape.innerHTML = `<span class="text-[11px] text-nasaq-textSecondary">سجل المحاولات فارغ. اضغط على (+) أو (-) لرصد المحاولة الأولى.</span>`;
            } else {
                tape.innerHTML = trials.map((t, idx) => `
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-bold px-2 py-1 rounded-md border ${t.isCorrect ? 'bg-nasaq-turquoiseLight text-nasaq-petrol border-nasaq-turquoise' : 'bg-slate-100 text-rose-700 border-rose-200'}">
                        <span>#${idx+1}</span>
                        <i class="fa-solid ${t.isCorrect ? 'fa-check' : 'fa-xmark'}"></i>
                        <span class="text-[9px] opacity-75">(${escapeHtml(t.prompt)})</span>
                        <button onclick="removeSingleTrial('${t.id}')" class="text-nasaq-textSecondary hover:text-rose-700 mr-1" title="حذف المحاولة"><i class="fa-solid fa-trash-can text-[9px]"></i></button>
                    </span>
                `).join('');
            }
        }

        function removeSingleTrial(trialId) {
            appDB.trials = appDB.trials.filter(t => t.id !== trialId);
            saveDB();
            updateTrackerMetrics();
        }

        function clearCurrentGoalTrials() {
            const benId = document.getElementById('tracker-ben-select').value;
            const goalId = document.getElementById('tracker-goal-select').value;

            if (confirm('هل ترغب في مسح محاولات هذا الهدف المحدد فقط؟')) {
                appDB.trials = appDB.trials.filter(t => !(t.benId === benId && t.goalId === goalId));
                saveDB();
                updateTrackerMetrics();
            }
        }

        function startTrackerClock() {
            if (trackerTimer) return;
            trackerTimer = setInterval(() => {
                trackerSeconds++;
                const m = String(Math.floor(trackerSeconds / 60)).padStart(2, '0');
                const s = String(trackerSeconds % 60).padStart(2, '0');
                document.getElementById('tracker-clock').textContent = `${m}:${s}`;
            }, 1000);
        }

        function stopTrackerClock() {
            clearInterval(trackerTimer);
            trackerTimer = null;
        }

        // التقارير والتصدير
        function generateReport() {
            const benId = document.getElementById('report-ben-select').value || currentActiveBenId;
            const ben = appDB.beneficiaries.find(b => b.id === benId);
            const container = document.getElementById('report-content-body');

            if (!ben) {
                container.innerHTML = `<p class="text-xs text-nasaq-textSecondary text-center py-6">يرجى تسجيل مستفيد وتحديده لاستخراج التقرير.</p>`;
                return;
            }

            document.getElementById('rep-date').textContent = new Date().toLocaleDateString('ar-EG');
            document.getElementById('rep-code').textContent = 'NSQ-' + ben.id.slice(-4).toUpperCase();

            const goals = appDB.goals.filter(g => g.benId === ben.id);
            const trials = appDB.trials.filter(t => t.benId === ben.id);

            let goalsRows = goals.length === 0 ? '<p class="text-xs text-nasaq-textSecondary">لا توجد أهداف إجرائية مسجلة حتى تاريخه.</p>' :
                goals.map(g => {
                    const gTrials = trials.filter(t => t.goalId === g.id);
                    const total = gTrials.length;
                    const correct = gTrials.filter(t => t.isCorrect).length;
                    
                    let statText = 'لا توجد بيانات قياس مسجلة بعد';
                    let statClass = 'text-nasaq-textSecondary';

                    if (total > 0) {
                        const pct = Math.round((correct / total) * 100);
                        statText = `نسبة الإتقان المحسوبة: ${pct}% (${correct}/${total} محاولة)`;
                        statClass = pct >= 80 ? 'text-nasaq-petrol font-bold' : 'text-nasaq-navy font-bold';
                    }

                    return `
                        <div class="p-3 bg-nasaq-bgLight rounded-xl border border-nasaq-border text-xs space-y-1">
                            <div class="flex justify-between items-center font-bold">
                                <span class="text-nasaq-navy text-sm">${escapeHtml(g.behavior)}</span>
                                <span class="${statClass}">${statText}</span>
                            </div>
                            <p class="text-nasaq-textSecondary"><strong>الشرط والمعيار:</strong> ${escapeHtml(g.condition || 'بيئة الجلسة')} — ${escapeHtml(g.criteria)} (${escapeHtml(g.prompt)})</p>
                        </div>
                    `;
                }).join('');

            container.innerHTML = `
                <div class="space-y-4">
                    <div class="bg-nasaq-bgLight p-4 rounded-xl border border-nasaq-border grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div><strong class="text-nasaq-textSecondary block">المعرف الرمزي:</strong><span class="font-bold text-nasaq-navy">${escapeHtml(ben.code)}</span></div>
                        <div><strong class="text-nasaq-textSecondary block">العمر النمائي:</strong><span class="font-bold text-nasaq-navy">${escapeHtml(ben.age)}</span></div>
                        <div><strong class="text-nasaq-textSecondary block">وسيلة التواصل:</strong><span class="font-bold text-nasaq-navy">${escapeHtml(ben.comm)}</span></div>
                        <div><strong class="text-nasaq-textSecondary block">حالة الخطة:</strong><span class="font-bold text-nasaq-petrol">${ben.status === 'active' ? 'نشط ميدانياً' : 'مؤرشف'}</span></div>
                    </div>

                    <div>
                        <h4 class="font-bold text-nasaq-navy text-sm mb-2 flex items-center gap-1.5">
                            <i class="fa-solid fa-bullseye text-nasaq-petrol"></i> نتائج الأهداف ومؤشرات الإتقان الفعلية:
                        </h4>
                        <div class="space-y-2">${goalsRows}</div>
                    </div>

                    <div class="border-t border-nasaq-border pt-3 text-xs space-y-2">
                        <h4 class="font-bold text-nasaq-navy text-sm">التوصيات التأهيلية وخطة التعميم المقترحة:</h4>
                        <p class="text-nasaq-navy leading-relaxed bg-nasaq-bgLight p-3 rounded-xl border border-nasaq-border">
                            استمرار التدخل وفق مسار خفض المساعدة التنازلي مع الحفاظ على التيسيرات البصرية والبيئية المتفق عليها، وتعميم المهارات التي بلغت معيار الإتقان في السياق الأسري الطبيعي.
                        </p>
                    </div>

                    <div class="flex justify-between items-end pt-8 text-[11px] text-nasaq-textSecondary">
                        <div>* هذا التقرير مستخرج ومحسوب رقمياً عبر منصة نَسَق | NASAQ استناداً إلى بيانات المحاولات المباشرة.</div>
                        <div class="text-center">
                            <div class="font-bold text-nasaq-navy">اعتماد أخصائي التأهيل</div>
                            <div class="border-b border-nasaq-border w-36 mt-4"></div>
                        </div>
                    </div>
                </div>
            `;
        }

        function exportReportToCSV() {
            const benId = document.getElementById('report-ben-select').value || currentActiveBenId;
            const ben = appDB.beneficiaries.find(b => b.id === benId);
            if (!ben) {
                alert('يرجى تحديد مستفيد أولاً للتصدير.');
                return;
            }

            const goals = appDB.goals.filter(g => g.benId === ben.id);
            const trials = appDB.trials.filter(t => t.benId === ben.id);

            let csvContent = "\uFEFF"; // دعم اللغة العربية في Excel عبر BOM
            csvContent += "المعرف الرمزي,الهدف الإجرائي,المعيار,إجمالي المحاولات,المحاولات الناجحة,نسبة الإتقان\n";

            goals.forEach(g => {
                const gTrials = trials.filter(t => t.goalId === g.id);
                const total = gTrials.length;
                const correct = gTrials.filter(t => t.isCorrect).length;
                const pct = total > 0 ? `${Math.round((correct / total) * 100)}%` : "غير مقاس";

                const row = [
                    `"${ben.code}"`,
                    `"${g.behavior.replace(/"/g, '""')}"`,
                    `"${g.criteria.replace(/"/g, '""')}"`,
                    total,
                    correct,
                    `"${pct}"`
                ];
                csvContent += row.join(",") + "\n";
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `تقرير_نسق_${ben.code.replace(/\s+/g, '_')}_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        function exportDatabaseJSON() {
            try {
                const str = JSON.stringify(appDB, null, 2);
                const blob = new Blob([str], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `nasaq-platform-backup-${new Date().toISOString().slice(0,10)}.json`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch (err) {
                alert('فشل تصدير النسخة الاحتياطية.');
            }
        }

        function importDatabaseJSON() {
            const input = document.getElementById('import-file');
            if (!input.files || input.files.length === 0) {
                alert('يرجى اختيار ملف JSON صالح.');
                return;
            }

            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed && typeof parsed === 'object' && Array.isArray(parsed.beneficiaries) && Array.isArray(parsed.goals)) {
                        appDB = parsed;
                        saveDB();
                        initApp();
                        alert('تم استيراد قاعدة بيانات نَسَق والتحقق من سلامة الجداول بنجاح!');
                    } else {
                        alert('خطأ: الملف المرفق لا يطابق بنية بيانات نَسَق | NASAQ.');
                    }
                } catch (err) {
                    alert('الملف المرفق تالف أو ليس بتنسيق JSON صحيح.');
                }
            };
            reader.readAsText(file);
        }

        function factoryReset() {
            if (confirm('تحذير نهائي: سيتم مسح كافة البيانات المسجلة نهائياً من متصفحك. هل أنت متأكد؟')) {
                localStorage.removeItem(STORAGE_KEY);
                location.reload();
            }
        }

        function populateAllDropdowns() {
            const benSelects = ['base-ben-id', 'goal-ben-id', 'tracker-ben-select', 'report-ben-select', 'ses-ben-id'];
            const activeBens = appDB.beneficiaries.filter(b => b.status === 'active');
            const benOptions = activeBens.length === 0 ? '<option value="">لا توجد حالات نشطة</option>' :
                activeBens.map(b => `<option value="${b.id}">${escapeHtml(b.code)} (${escapeHtml(b.age)})</option>`).join('');

            benSelects.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = benOptions;
            });

            const domSelects = ['goal-domain-id', 'act-domain-id', 'filter-activity-domain', 'new-skill-domain-id'];
            const domOptions = appDB.domains.map(d => `<option value="${d.id}">${escapeHtml(d.name)}</option>`).join('');

            domSelects.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    if (id === 'filter-activity-domain') el.innerHTML = '<option value="all">كافة المجالات</option>' + domOptions;
                    else el.innerHTML = domOptions;
                }
            });

            populateSkillOptionsForGoal();
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        window.onclick = function(e) {
            if (e.target.classList.contains('fixed') && !e.target.classList.contains('hidden')) {
                e.target.classList.add('hidden');
            }
        };

        document.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
