        function navigate(viewId) {
            document.querySelectorAll('.app-view').forEach(el => el.classList.add('hidden'));
            const target = document.getElementById(`view-${viewId}`);
            if (target) target.classList.remove('hidden');

            document.querySelectorAll('.app-nav-btn').forEach(btn => {
                if (btn.dataset.nav === viewId) btn.classList.add('nav-active');
                else btn.classList.remove('nav-active');
            });

            document.querySelectorAll('.mobile-nav-btn').forEach(btn => {
                if (btn.dataset.nav === viewId) {
                    btn.classList.add('text-nasaq-petrol');
                    btn.classList.remove('text-nasaq-textSecondary');
                } else {
                    btn.classList.remove('text-nasaq-petrol');
                    btn.classList.add('text-nasaq-textSecondary');
                }
            });

            if (viewId === 'tracker') {
                startTrackerClock();
                syncTrackerGoals();
            } else {
                stopTrackerClock();
            }

            if (viewId === 'reports') {
                generateReport();
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

